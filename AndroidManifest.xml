<?xml version="1.0" encoding="utf-8"?>
<!--
  api102 模块 Manifest 模板
  注意:
    - minSdk 必须 ≥ 26 (api102 要求)
    - 无需传统 xposed meta-data (xposedmodule/xposeddescription/xposedscope)
    - versionCode/versionName 会被 build.sh 自动写回
    - 模块标识/作用域 在 META-INF/xposed/ 声明, 不在这里
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="69"
    android:versionName="1.5.0"
    package="com.vstory.hook.rikkahub">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="37" />
    <application
        android:name="com.vstory.hook.rikkahub.RikkaTuneApp"
        android:label="RikkaTune"
        android:description="@string/module_description"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault">
        <!-- 控制面板: LSPosed 管理器"打开"入口 (LAUNCHER), 也可桌面图标进入 -->
        <!-- exported=true 必要: 框架/桌面用 startActivity 跨应用拉起 -->
        <activity
            android:name="com.vstory.hook.rikkahub.RikkaTuneActivity"
            android:exported="true"
            android:label="RikkaTune"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ⚠️ libxposed service 连接点: 框架按 authority 调 provider.call(SEND_BINDER) 向模块自身进程
             发 binder (UI 控制面板连框架必需; 纯 hook 模块可无, 带 UI 必须有!) -->
        <!-- authority 写死包名(不能用 ${applicationId}: build.sh 用 aapt v1 不替换占位符) -->
        <!-- exported=true: 框架(其他进程)要能调它 -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.vstory.hook.rikkahub.XposedService"
            android:exported="true" />
    </application>
</manifest>
